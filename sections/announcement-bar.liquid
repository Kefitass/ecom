{%- if section.blocks.size > 0 -%}
  <div class="announcement announcement--{{ section.settings.style }}" style="--speed: {{ section.settings.speed }}s;">
    <div class="announcement__track">
      {%- for i in (1..2) -%}
        <div class="announcement__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="announcement__item" {% if forloop.first and n == 1 and i == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
              {%- if section.settings.separator != blank -%}<span class="announcement__sep" aria-hidden="true">{{ section.settings.separator }}</span>{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "default": "violet",
      "options": [
        { "value": "violet", "label": "Violeta" },
        { "value": "gold", "label": "Dorado" },
        { "value": "dark", "label": "Oscuro" }
      ]
    },
    { "type": "text", "id": "separator", "label": "Separador", "default": "" },
    { "type": "range", "id": "speed", "label": "Velocidad (segundos por vuelta)", "min": 10, "max": 80, "step": 2, "default": 40 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "ENVÍO GRATIS A TODO EL PAÍS" },
        { "type": "url", "id": "link", "label": "Link (opcional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "announcement", "settings": { "text": "3 CUOTAS SIN INTERÉS" } },
        { "type": "announcement", "settings": { "text": "ENVÍO GRATIS A TODO EL PAÍS" } },
        { "type": "announcement", "settings": { "text": "PROMOCIONES 3X1" } }
      ]
    }
  ]
}
{% endschema %}

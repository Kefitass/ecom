{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="--speed: {{ section.settings.speed }}s;">
    <div class="announcement__track">
      {%- for i in (1..2) -%}
        <div class="announcement__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="announcement__item" {% if forloop.first and n == 1 and i == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidad (segundos por vuelta)",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "ENVÍO GRATIS" },
        { "type": "url", "id": "link", "label": "Link (opcional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "announcement", "settings": { "text": "ENVÍO GRATIS" } },
        { "type": "announcement", "settings": { "text": "3 CUOTAS SIN INTERÉS" } },
        { "type": "announcement", "settings": { "text": "LLEVÁ 2 Y AHORRÁ 30%" } }
      ]
    }
  ]
}
{% endschema %}

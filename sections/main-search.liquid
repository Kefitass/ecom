<section class="section">
  <div class="page-width">
    {% render 'section-heading', eyebrow: 'BUSCADOR', title: 'Buscá tu perfume', tag: 'h1' %}

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Ej: vainilla, oud, nombre del perfume..." aria-label="Buscar">
      <button type="submit" class="button button--primary">{% render 'icon', name: 'search', px: 18 %} Buscar</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 16 -%}
        <p class="search-count">{{ search.results_count }} resultado{% if search.results_count != 1 %}s{% endif %} para “{{ search.terms }}”</p>
        {%- if search.results_count > 0 -%}
          <div class="product-grid product-grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="card card--padded search-result">
                  <h3>{{ item.title }}</h3>
                  <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="empty-state">No encontramos nada. Probá con otra palabra o escribinos por WhatsApp.</p>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Búsqueda",
  "settings": [
  ]
}
{% endschema %}

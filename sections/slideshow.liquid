<section class="slideshow-section">
  <div class="slideshow" data-slideshow data-autoplay="{{ section.settings.autoplay_speed }}">
    <div class="slideshow__track" data-slideshow-track>
      {%- for block in section.blocks -%}
        <div class="slideshow__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign loading = 'lazy'
              if forloop.first
                assign loading = 'eager'
              endif
            -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w">
              {%- endif -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '750, 1100, 1500, 1920, 2400',
                  sizes: '100vw',
                  loading: loading,
                  alt: block.settings.alt
              }}
            </picture>
          {%- else -%}
            <div class="slideshow__placeholder">
              <strong>{{ block.settings.alt | default: 'Subí tu banner' }}</strong>
              <span>1920 × 800 px en compu · 1080 × 1080 px en celu</span>
            </div>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slideshow-prev aria-label="Anterior">{% render 'icon', name: 'chevron-left', px: 22 %}</button>
      <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slideshow-next aria-label="Siguiente">{% render 'icon', name: 'chevron-right', px: 22 %}</button>
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button type="button" data-slideshow-dot="{{ forloop.index0 }}" aria-label="Ir al banner {{ forloop.index }}"{% if forloop.first %} class="is-active"{% endif %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Slider de banners",
  "class": "section-slideshow",
  "settings": [
    { "type": "range", "id": "autoplay_speed", "label": "Cambiar cada (segundos, 0 = no cambia solo)", "min": 0, "max": 12, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen para compu", "info": "1920 × 800 px" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen para celu (opcional)", "info": "1080 × 1080 px" },
        { "type": "text", "id": "alt", "label": "Texto alternativo", "default": "Promo 3x1 en perfumes árabes" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Slider de banners",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<section class="section">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      no_line: section.settings.hide_line
    %}

    <div class="product-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- assign shown = 0 -%}
        {%- for item in collection.products -%}
          {%- if product and item.id == product.id -%}{%- continue -%}{%- endif -%}
          {% render 'product-card', product: item, pill: section.settings.show_pill %}
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="product-card__body">
              <h3 class="product-card__title">¡3x1 Perfumes árabes!</h3>
              <p class="installments">Elegí una colección en el editor para mostrar tus productos.</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="section__footer">
        <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="button button--grad">
          {{ section.settings.button_label }} {% render 'icon', name: 'arrow', px: 18 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grilla de productos",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Pastilla", "default": "PROMOS DE LA CASA" },
    { "type": "text", "id": "title", "label": "Título", "default": "Promociones actuales" },
    { "type": "richtext", "id": "subtitle", "label": "Subtítulo" },
    { "type": "checkbox", "id": "hide_line", "label": "Ocultar línea degradé bajo el título", "default": false },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 2, "max": 48, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "show_pill", "label": "Mostrar 'Ahorrás un X% · Precio especial de hoy'", "default": false },
    { "type": "text", "id": "button_label", "label": "Botón inferior" }
  ],
  "presets": [{ "name": "Grilla de productos" }]
}
{% endschema %}

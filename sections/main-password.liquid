<section class="section password">
  <div class="page-width page-width--narrow">
    <div class="card card--padded password__card">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'password__logo' }}
      {%- else -%}
        <p class="header__logo-text">{{ shop.name }}</p>
      {%- endif -%}
      <h1 class="section-heading__title">{{ section.settings.title }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

      {%- form 'customer', class: 'password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="prelanzamiento">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">¡Listo! Te avisamos cuando abramos.</p>
        {%- else -%}
          <div class="search-form">
            <input type="email" name="contact[email]" placeholder="tu@email.com" required aria-label="Email">
            <button type="submit" class="button button--accent">Avisame</button>
          </div>
        {%- endif -%}
      {%- endform -%}

      <details class="password__login">
        <summary>¿Sos el dueño? Ingresá con la contraseña</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="form-message form-message--error">Contraseña incorrecta.</p>{%- endif -%}
          <div class="search-form">
            <input type="password" name="password" placeholder="Contraseña" aria-label="Contraseña" required>
            <button type="submit" class="button button--primary">Entrar</button>
          </div>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Muy pronto abrimos ✨" }
  ]
}
{% endschema %}

<section class="hero section" style="--section-bg: {{ section.settings.background }};">
  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- if section.settings.pill != blank -%}
        <p class="pill">{% if section.settings.pill_emoji != blank %}<span aria-hidden="true">{{ section.settings.pill_emoji }}</span>{% endif %} {{ section.settings.pill }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary button--lg button--shadow">
            {{ section.settings.button_label }} {% render 'icon', name: 'arrow', px: 18 %}
          </a>
        {%- endif -%}
        {% render 'stars', rating: section.settings.rating, text: section.settings.rating_text %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="checks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check', px: 18 %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__media">
      <div class="hero__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 520px, 100vw'
          }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.sticker_top != blank -%}
        <div class="sticker">
          <strong>{{ section.settings.sticker_top }}</strong>
          <span>{{ section.settings.sticker_bottom }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero principal",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "pill_emoji", "label": "Emoji de la etiqueta", "default": "✨" },
    { "type": "text", "id": "pill", "label": "Etiqueta superior", "default": "+1.000 clientes del barrio ya lo eligen" },
    { "type": "textarea", "id": "heading", "label": "Título", "default": "Perfumes árabes que duran todo el día" },
    { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Fragancias originales de las mejores casas árabes, con fijación de verdad y a precio de barrio. Te asesoramos por WhatsApp para que encuentres tu aroma.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero mi perfume" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "header", "content": "Calificación" },
    { "type": "text", "id": "rating", "label": "Puntaje", "default": "4.9", "info": "Usá tu puntaje real. Dejalo vacío para ocultarlo." },
    { "type": "text", "id": "rating_text", "label": "Texto", "default": "+1.000 clientes felices" },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "sticker_top", "label": "Sello circular: línea grande", "default": "HASTA 35%" },
    { "type": "text", "id": "sticker_bottom", "label": "Sello circular: línea chica", "default": "OFF en packs" },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#f3f1ef" }
  ],
  "blocks": [
    {
      "type": "check",
      "name": "Beneficio con tilde",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "100% originales" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero principal",
      "blocks": [
        { "type": "check", "settings": { "text": "100% originales" } },
        { "type": "check", "settings": { "text": "Larga duración" } },
        { "type": "check", "settings": { "text": "Asesoramiento por WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}

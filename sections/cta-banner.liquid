{%- capture wa_url -%}{% render 'whatsapp-url' %}{%- endcapture -%}
<section class="section section--tight" style="--section-bg: {{ section.settings.background }};">
  <div class="page-width">
    <div class="cta-banner">
      <div class="cta-banner__content">
        {%- if section.settings.eyebrow != blank -%}<p class="pill pill--on-dark">{% render 'icon', name: 'zap', px: 14 %} {{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        <div class="cta-banner__text">{{ section.settings.text }}</div>
      </div>
      <div class="cta-banner__actions">
        {%- if section.settings.button_type == 'whatsapp' -%}
          <a href="{{ wa_url | strip }}" target="_blank" rel="noopener" class="button button--whatsapp button--lg">
            {% render 'icon', name: 'whatsapp', px: 20 %} {{ section.settings.button_label }}
          </a>
        {%- else -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--accent button--lg">
            {{ section.settings.button_label }} {% render 'icon', name: 'arrow', px: 18 %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Llamado a la acción",
  "class": "section-cta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "RESPUESTA MÁS RÁPIDA" },
    { "type": "text", "id": "title", "label": "Título", "default": "¿No sabés cuál elegir?" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Contanos qué aromas te gustan y te recomendamos tu perfume ideal.</p>" },
    {
      "type": "select",
      "id": "button_type",
      "label": "Tipo de botón",
      "default": "whatsapp",
      "options": [
        { "value": "whatsapp", "label": "WhatsApp" },
        { "value": "link", "label": "Link" }
      ]
    },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Abrir WhatsApp" },
    { "type": "url", "id": "button_link", "label": "Link (si el tipo es Link)" },
    { "type": "color", "id": "background", "label": "Color de fondo de la sección", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Llamado a la acción" }]
}
{% endschema %}

<section class="landing">
  <div class="landing__col landing-pad{% if section.settings.alt_bg %} landing__col--alt{% endif %}">
    {% render 'landing-heading', eyebrow: section.settings.eyebrow, title: section.settings.title, title_gold: section.settings.title_gold, text: section.settings.text %}

    <div class="l-cards l-cards--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="l-card l-card--{{ block.settings.accent }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="l-card__img">{{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name }}</div>
          {%- elsif block.settings.emoji != blank -%}
            <div class="l-card__emoji" aria-hidden="true">{{ block.settings.emoji }}</div>
          {%- endif -%}
          {%- if block.settings.tag != blank -%}<p class="l-card__tag">{{ block.settings.tag }}</p>{%- endif -%}
          <h3>{% render 'cuotas-fix', t: block.settings.name %}</h3>
          {%- if block.settings.text != blank -%}<p>{% render 'cuotas-fix', t: block.settings.text %}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing · Tarjetas",
  "class": "section-landing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Pastilla", "default": "UNO PARA CADA OCASIÓN" },
    { "type": "text", "id": "title", "label": "Título (blanco)", "default": "No son tres perfumes iguales." },
    { "type": "text", "id": "title_gold", "label": "Título (dorado)", "default": "Cada uno tiene su momento." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Así siempre tenés el indicado, salgas a donde salgas.</p>" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fondo un poco más claro", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (frasco sin fondo, PNG)" },
        { "type": "text", "id": "emoji", "label": "Emoji (si no hay imagen)" },
        { "type": "text", "id": "tag", "label": "Etiqueta", "default": "🌙 NOCHE Y SALIDAS" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Perfume 1" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Especiado e intenso. Se siente de lejos." },
        {
          "type": "select", "id": "accent", "label": "Color", "default": "gold",
          "options": [
            { "value": "gold", "label": "Dorado" },
            { "value": "rose", "label": "Rosado" },
            { "value": "teal", "label": "Turquesa" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Landing · Tarjetas",
      "blocks": [
        { "type": "card", "settings": { "tag": "🌙 NOCHE Y SALIDAS", "name": "Perfume 1", "text": "Especiado e intenso. Se siente de lejos.", "accent": "gold" } },
        { "type": "card", "settings": { "tag": "💋 CITAS", "name": "Perfume 2", "text": "Dulce y cálido. Para estar cerca.", "accent": "rose" } },
        { "type": "card", "settings": { "tag": "☀️ DÍA A DÍA", "name": "Perfume 3", "text": "Frutal y fresco. Va con todo.", "accent": "teal" } }
      ]
    }
  ]
}
{% endschema %}

{%- capture wa_url -%}{% render 'whatsapp-url' %}{%- endcapture -%}
<footer class="footer-wrap">
  <div class="footer">
    <div class="footer__inner">
      <div class="footer__top">
        <div class="footer__brand">
          <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
            {%- if settings.logo != blank -%}
              {{ settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name, class: 'footer__logo-img' }}
            {%- else -%}
              {% render 'brand-logo', variant: 'light', width: 200 %}
            {%- endif -%}
          </a>
          {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="footer__text">{{ section.settings.text }}</div>{%- endif -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', px: 17 %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', px: 17 %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', px: 17 %}</a>
            {%- endif -%}
            {%- if settings.whatsapp_number != blank -%}
              <a href="{{ wa_url | strip }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp', px: 17 %}</a>
            {%- endif -%}
          </div>
        </div>

        <nav class="footer__col" aria-label="{{ section.settings.menu_title }}">
          <h3>{{ section.settings.menu_title }}</h3>
          <ul>
            {%- if section.settings.menu.links.size > 0 -%}
              {%- for link in section.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="{{ routes.all_products_collection_url }}">Todos los perfumes</a></li>
              <li><a href="{{ routes.search_url }}?type=product&q=3x1">Combos 3x1</a></li>
              <li><a href="{{ routes.search_url }}?type=product&q=perfume">Perfumes individuales</a></li>
            {%- endif -%}
          </ul>
        </nav>

        <nav class="footer__col" aria-label="{{ section.settings.help_title }}">
          <h3>{{ section.settings.help_title }}</h3>
          <ul>
            {%- if section.settings.help_menu.links.size > 0 -%}
              {%- for link in section.settings.help_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/contact">Contacto</a></li>
              <li><a href="{{ routes.account_url }}">Seguí tu pedido</a></li>
              <li><a href="/policies/shipping-policy">Envíos</a></li>
            {%- endif -%}
          </ul>
        </nav>

        <div class="footer__col">
          <h3>{{ section.settings.contact_title }}</h3>
          <ul class="footer__contact">
            {%- assign footer_email = settings.contact_email | default: 'somoscasadeloud@gmail.com' -%}
            <li>{% render 'icon', name: 'mail', px: 16 %}<a href="mailto:{{ footer_email }}">{{ footer_email }}</a></li>
            {%- if settings.whatsapp_number != blank -%}
              <li>{% render 'icon', name: 'whatsapp', px: 16 %}<a href="{{ wa_url | strip }}" target="_blank" rel="noopener">{{ settings.whatsapp_number }}</a></li>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <li>{% render 'icon', name: 'phone', px: 16 %}<a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></li>
            {%- endif -%}
            {%- if settings.contact_hours != blank -%}
              <li>{% render 'icon', name: 'clock', px: 16 %}<span>{{ settings.contact_hours }}</span></li>
            {%- endif -%}
          </ul>
        </div>
      </div>

      <div class="footer__mid">
        <div class="footer__group">
          <p class="footer__label">Medios de pago</p>
          <ul class="footer__logos">
            {%- if section.settings.payments_image != blank -%}
              <li>{{ section.settings.payments_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'footer__logos-img' }}</li>
            {%- else -%}
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
        {%- if section.settings.shipping_image != blank or section.settings.shipping_text != blank -%}
          <div class="footer__group">
            <p class="footer__label">Envíos</p>
            {%- if section.settings.shipping_image != blank -%}
              {{ section.settings.shipping_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'footer__logos-img' }}
            {%- else -%}
              <p class="footer__shipping">{% render 'icon', name: 'truck', px: 16 %} {{ section.settings.shipping_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="footer__bottom">
        <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.cuit != blank %} · CUIT {{ section.settings.cuit }}{% endif %}. Todos los derechos reservados.</p>
        <p class="footer__legal">
          <a href="{{ section.settings.consumer_link | default: 'https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario' }}" target="_blank" rel="noopener">Defensa del consumidor</a>
          {%- if section.settings.regret_link != blank -%}<span aria-hidden="true">·</span><a href="{{ section.settings.regret_link }}">Botón de arrepentimiento</a>{%- endif -%}
        </p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Frase de marca", "default": "Perfumes árabes, como en casa." },
    { "type": "richtext", "id": "text", "label": "Texto corto", "default": "<p>Fragancias árabes y de nicho, elegidas una por una. Envíos a todo el país.</p>" },
    { "type": "header", "content": "Columnas" },
    { "type": "text", "id": "menu_title", "label": "Título columna 1", "default": "Tienda" },
    { "type": "link_list", "id": "menu", "label": "Menú columna 1", "info": "Vacío = muestra links de la tienda." },
    { "type": "text", "id": "help_title", "label": "Título columna 2", "default": "Ayuda" },
    { "type": "link_list", "id": "help_menu", "label": "Menú columna 2", "info": "Vacío = muestra contacto, seguimiento y envíos." },
    { "type": "text", "id": "contact_title", "label": "Título de contacto", "default": "Contacto" },
    { "type": "text", "id": "phone", "label": "Teléfono (opcional)" },
    { "type": "paragraph", "content": "Email, WhatsApp, horario y redes se cargan en Configuración del tema → Contacto y redes." },
    { "type": "header", "content": "Medios de pago y envío" },
    { "type": "image_picker", "id": "payments_image", "label": "Imagen de medios de pago (opcional)", "info": "Vacío = íconos de los pagos activos en Shopify." },
    { "type": "image_picker", "id": "shipping_image", "label": "Imagen de medios de envío (opcional)" },
    { "type": "text", "id": "shipping_text", "label": "Texto de envíos", "default": "Envío gratis a todo el país" },
    { "type": "header", "content": "Datos legales (Argentina)" },
    { "type": "text", "id": "cuit", "label": "CUIT" },
    { "type": "url", "id": "consumer_link", "label": "Link de Defensa del Consumidor", "info": "Vacío = formulario oficial de argentina.gob.ar" },
    { "type": "url", "id": "regret_link", "label": "Link del Botón de arrepentimiento", "info": "Obligatorio en Argentina." }
  ]
}
{% endschema %}

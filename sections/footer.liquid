{%- capture wa_url -%}{% render 'whatsapp-url' %}{%- endcapture -%}
<footer class="footer-wrap">
  <div class="footer">
    <div class="footer__grid">
      <div class="footer__col">
        <h3>{{ section.settings.menu_title }}</h3>
        <ul>
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer__col">
        <h3>{{ section.settings.contact_title }}</h3>
        <ul class="footer__contact">
          {%- if settings.whatsapp_number != blank -%}
            <li>{% render 'icon', name: 'whatsapp', px: 15 %} <a href="{{ wa_url | strip }}" target="_blank" rel="noopener">{{ settings.whatsapp_number }}</a></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>{% render 'icon', name: 'phone', px: 15 %} <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></li>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <li>{% render 'icon', name: 'mail', px: 15 %} <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="footer__col">
        <h3>{{ section.settings.social_title }}</h3>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', px: 16 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', px: 16 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', px: 16 %}</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="footer__row">
      <h3>Medios de pago</h3>
      <ul class="footer__logos">
        {%- if section.settings.payments_image != blank -%}
          <li>{{ section.settings.payments_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'footer__logos-img' }}</li>
        {%- else -%}
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    {%- if section.settings.shipping_image != blank or section.settings.shipping_text != blank -%}
      <div class="footer__row">
        <h3>Medios de envío</h3>
        <div class="footer__logos">
          {%- if section.settings.shipping_image != blank -%}
            {{ section.settings.shipping_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'footer__logos-img' }}
          {%- else -%}
            <span class="footer__shipping-text">{{ section.settings.shipping_text }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p>
        Copyright {{ shop.name }}{% if section.settings.cuit != blank %} - {{ section.settings.cuit }}{% endif %} - {{ 'now' | date: '%Y' }}. Todos los derechos reservados.<br>
        Defensa de las y los consumidores. Para reclamos
        <a href="{{ section.settings.consumer_link | default: 'https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario' }}" target="_blank" rel="noopener"><strong>ingresá acá</strong></a>.
        {%- if section.settings.regret_link != blank %} / <a href="{{ section.settings.regret_link }}"><strong>Botón de arrepentimiento</strong></a>{% endif %}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "menu_title", "label": "Título del menú", "default": "Categorías" },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" },
    { "type": "text", "id": "contact_title", "label": "Título de contacto", "default": "Contactanos" },
    { "type": "text", "id": "phone", "label": "Teléfono (opcional)" },
    { "type": "text", "id": "social_title", "label": "Título de redes", "default": "Sigamos conectados" },
    { "type": "paragraph", "content": "WhatsApp, email y redes se cargan en Configuración del tema → Contacto y redes." },
    { "type": "header", "content": "Medios de pago y envío" },
    { "type": "image_picker", "id": "payments_image", "label": "Imagen de medios de pago (opcional)", "info": "Vacío = se muestran los íconos de los pagos activos en Shopify." },
    { "type": "image_picker", "id": "shipping_image", "label": "Imagen de medios de envío (opcional)" },
    { "type": "text", "id": "shipping_text", "label": "Texto de medios de envío", "default": "Andreani · Correo Argentino" },
    { "type": "header", "content": "Datos legales (Argentina)" },
    { "type": "text", "id": "cuit", "label": "CUIT" },
    { "type": "url", "id": "consumer_link", "label": "Link de Defensa del Consumidor", "info": "Vacío = formulario oficial de argentina.gob.ar" },
    { "type": "url", "id": "regret_link", "label": "Link del Botón de arrepentimiento", "info": "Obligatorio en Argentina. Creá una página con el formulario y pegá el link." }
  ]
}
{% endschema %}

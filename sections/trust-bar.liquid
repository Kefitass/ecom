<section class="trust-bar"{% if section.settings.background != blank %} style="--trust-bg: {{ section.settings.background }};"{% endif %}>
  <div class="page-width trust-bar__inner">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon">{% render 'icon', name: block.settings.icon, px: 22 %}</span>
        <div>
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Barra de confianza",
  "class": "section-trust",
  "settings": [
    { "type": "color", "id": "background", "label": "Color de fondo", "info": "Vacío = color principal del tema." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ítem",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Camión" },
            { "value": "card", "label": "Tarjeta" },
            { "value": "shield", "label": "Escudo" },
            { "value": "chat", "label": "Chat" },
            { "value": "gift", "label": "Regalo" },
            { "value": "sparkles", "label": "Brillos" },
            { "value": "package", "label": "Paquete" },
            { "value": "clock", "label": "Reloj" },
            { "value": "heart", "label": "Corazón" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Despacho en 24 hs" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "A todo el país" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Barra de confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Despacho en 24 hs", "subtitle": "A todo el país" } },
        { "type": "item", "settings": { "icon": "card", "title": "3 cuotas sin interés", "subtitle": "Con todas las tarjetas" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Garantía 100%", "subtitle": "Compra protegida" } },
        { "type": "item", "settings": { "icon": "chat", "title": "Atención 24/7", "subtitle": "Por WhatsApp y mail" } }
      ]
    }
  ]
}
{% endschema %}

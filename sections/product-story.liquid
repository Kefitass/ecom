{%- liquid
  assign story = nil
  assign fallback = nil
  assign my_name = ''
  if product
    assign my_name = product.title | split: ' · ' | first | strip | downcase
  endif
  for block in section.blocks
    assign key = block.settings.product | strip | downcase
    if key == blank
      if fallback == nil
        assign fallback = block
      endif
    elsif key == my_name
      assign story = block
      break
    endif
  endfor
  if story == nil
    assign story = fallback
  endif
-%}

{%- if story -%}
  <section class="section product-story" {{ story.shopify_attributes }}>
    <div class="page-width page-width--narrow product-story__inner">
      {%- if story.settings.eyebrow != blank -%}<p class="product-story__eyebrow">{{ story.settings.eyebrow }}</p>{%- endif -%}
      {%- if story.settings.title != blank -%}<h2 class="product-story__title">{{ story.settings.title }}</h2>{%- endif -%}
      {%- if story.settings.text != blank -%}<div class="product-story__text">{{ story.settings.text }}</div>{%- endif -%}
      {%- if story.settings.highlight != blank -%}<p class="product-story__highlight">{{ story.settings.highlight }}</p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Historia del perfume",
  "class": "section-product-story",
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra el bloque cuyo campo 'Perfume' coincide con el nombre del producto (lo que va antes del '·'). Si ninguno coincide, usa el bloque con 'Perfume' vacío."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Historia",
      "settings": [
        {
          "type": "text",
          "id": "product",
          "label": "Perfume",
          "info": "Ej: Mandarin Sky. Vacío = se usa para los perfumes sin historia propia."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Pastilla",
          "default": "EL DULCE MÁS VIRAL DE ARMAF"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Odyssey Mandarin Sky se volvió viral por algo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Mandarina luminosa sobre un fondo dulce y cremoso.</p>"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Frase destacada",
          "default": "Si viste este perfume recomendado en todos lados, hay una razón."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Historia del perfume",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "product": "",

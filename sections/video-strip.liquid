<section class="video-strip-section">
  <div class="page-width">
    {%- if section.settings.title != blank -%}<h2 class="video-strip__title">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="video-strip" data-scroller>
      {%- for block in section.blocks -%}
        <div class="video-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: image_size: '500x', controls: true, muted: true, playsinline: true, preload: 'none' }}
          {%- elsif block.settings.image != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.caption }}
            <span class="video-strip__play" aria-hidden="true">▶</span>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- else -%}
            <div class="video-strip__empty">Subí un video vertical</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 3 -%}
      <div class="video-strip__nav">
        <button type="button" data-scroll="-1" aria-label="Anterior">{% render 'icon', name: 'chevron-left', px: 18 %}</button>
        <button type="button" data-scroll="1" aria-label="Siguiente">{% render 'icon', name: 'chevron-right', px: 18 %}</button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Videos (compra segura)",
  "class": "section-video-strip",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "🔒 COMPRA SEGURO/A 🔒" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (vertical)" },
        { "type": "image_picker", "id": "image", "label": "O una portada con link" },
        { "type": "url", "id": "link", "label": "Link (por ejemplo, el reel de Instagram)" },
        { "type": "text", "id": "caption", "label": "Descripción" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Videos (compra segura)",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}

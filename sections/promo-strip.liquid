{%- if section.settings.text != blank -%}
  <div class="promo-strip">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Franja de promo",
  "class": "section-promo-strip",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "🔥 50% OFF EN TODA LA TIENDA 🔥" },
    { "type": "url", "id": "link", "label": "Link (opcional)" }
  ],
  "presets": [{ "name": "Franja de promo" }]
}
{% endschema %}

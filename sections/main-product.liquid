{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign pct = settings.transfer_discount | plus: 0
  assign count = settings.installments_count | plus: 0
  assign min_cents = settings.installments_min | plus: 0 | times: 100
  assign tags_down = product.tags | join: ',' | downcase
  assign is_combo = false
  if tags_down contains '3x1' and product.title contains ' · '
    assign is_combo = true
  endif
  capture wa_url
    render 'whatsapp-url'
  endcapture
-%}

<section class="section product" data-product-section>
  <div class="page-width product__grid">
    <div class="product__gallery">
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="product__thumb{% if media.id == current_variant.featured_media.id or current_variant.featured_media == nil and forloop.first %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Ver imagen {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 220, height: 220, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="product__main-image">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="product__slide{% if media.id == current_variant.featured_media.id or current_variant.featured_media == nil and forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 700, 900, 1100, 1400', sizes: '(min-width: 990px) 640px, 100vw', alt: media.alt }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="product__slide is-active">{{ 'product-3' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endif -%}
        {%- if settings.card_sticker_top != blank and tags_down contains '3x1' -%}
          <span class="sticker-badge sticker-badge--lg">
            <strong>{{ settings.card_sticker_top }}</strong>
            {%- if settings.card_sticker_bottom != blank -%}<small>{{ settings.card_sticker_bottom }}</small>{%- endif -%}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="product__info">
      {%- if section.settings.proof != blank -%}
        <p class="proof-pill">{% render 'icon', name: 'check', px: 14 %} {{ section.settings.proof }}</p>
      {%- endif -%}

      <h1 class="product__title">{{ product.title }}</h1>

      {%- if rating != blank -%}
        {% render 'stars', rating: rating.rating, count: rating_count %}
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- liquid
          assign social_assets = 'resena-khamrah-qahwa-01.webp,resena-mandarin-sky-01.webp,resena-erba-pura-01.webp,resena-yara-moi-01.webp' | split: ','
        -%}
        <a class="social-proof" href="#resenas">
          <span class="social-proof__faces">
            {%- for i in (1..4) -%}
              {%- assign ik = 'social_img' | append: i -%}
              {%- if section.settings[ik] != blank -%}
                {{ section.settings[ik] | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- assign idx = forloop.index0 -%}
                <img src="{{ social_assets[idx] | asset_url }}" width="48" height="48" loading="lazy" alt="">
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="social-proof__text">
            <span class="social-proof__stars" aria-label="5 de 5 estrellas">★★★★★</span>
            <span>{{ section.settings.social_text }}</span>
          </span>
        </a>
      {%- endif -%}

      <div class="product__prices">
        <s class="price__compare" data-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        <span class="price__current price__current--xl" data-price>{{ current_variant.price | money }}</span>
      </div>

      {%- if settings.transfer_show and pct > 0 -%}
        {%- liquid
          assign keep = 100 | minus: pct
          assign transfer_price = current_variant.price | times: keep | divided_by: 100
        -%}
        <p class="product__transfer"><span data-transfer>{{ transfer_price | money }}</span> con TRANSFERENCIA</p>
        <p class="save-pill save-pill--lg"><span aria-hidden="true">💸</span> Ahorrás un {{ pct }}% · Precio especial de hoy</p>
      {%- endif -%}

      <div class="product__pay-box">
        {%- if settings.installments_show and count > 1 -%}
          <p data-installments-yes{% if current_variant.price < min_cents %} hidden{% endif %}>{% render 'icon', name: 'card', px: 18 %} <span><strong>{{ count }} cuotas sin interés</strong>{% if settings.installments_show_amount %} de <strong data-installment>{{ current_variant.price | divided_by: count | money }}</strong>{% endif %}</span></p>
          <p data-installments-no{% if current_variant.price >= min_cents %} hidden{% endif %}>{% render 'icon', name: 'card', px: 18 %} <span><strong>{{ count }} cuotas sin interés</strong> en compras desde {{ min_cents | money_without_trailing_zeros }}</span></p>
        {%- endif -%}
        {%- if settings.transfer_show and pct > 0 -%}
          <p>{% render 'icon', name: 'package', px: 18 %} <span><strong>{{ pct }}% de descuento</strong> pagando con TRANSFERENCIA</span></p>
        {%- endif -%}
        {%- if section.settings.pay_details != blank -%}
          <details class="product__pay-details">
            <summary>Ver más detalles</summary>
            <div class="rte">{% render 'cuotas-fix', t: section.settings.pay_details %}</div>
          </details>
        {%- endif -%}
      </div>

      {%- if section.settings.shipping_text != blank -%}
        <p class="product__shipping">{% render 'icon', name: 'truck', px: 20 %} {{ section.settings.shipping_text }}</p>
      {%- endif -%}

      {%- if is_combo and section.settings.show_bundle -%}
        {%- liquid
          assign combo_list = product.title | split: ' · ' | last
          assign combo_items = combo_list | split: ' + '
          assign sum = 0
          assign perfumes = 0
          assign found = 0
          assign gift_name = ''
        -%}
        <div class="bundle">
          {%- if section.settings.bundle_title != blank -%}<p class="bundle__head">{{ section.settings.bundle_title }}</p>{%- endif -%}
          <ul class="bundle__items">
            {%- for item in combo_items -%}
              {%- liquid
                assign item_name = item | strip
                assign item_down = item_name | downcase
                if item_down contains 'mini'
                  assign gift_name = item_name
                  continue
                endif
                assign perfumes = perfumes | plus: 1
                assign match = nil
                for p in collections.all.products
                  assign p_name = p.title | split: ' · ' | first | strip | downcase
                  if p_name == item_down and p.id != product.id
                    assign match = p
                    break
                  endif
                endfor
              -%}
              <li class="bundle__item">
                <span class="bundle__thumb">
                  {%- if match.featured_image -%}
                    {{ match.featured_image | image_url: width: 140, height: 140, crop: 'center' | image_tag: loading: 'lazy', alt: item_name }}
                  {%- else -%}
                    <span>{{ forloop.index }}</span>
                  {%- endif -%}
                </span>
                <span class="bundle__name">
                  <strong>{{ item_name }}</strong>
                  {%- if match -%}<small>{{ match.title | split: ' · ' | last }}</small>{%- endif -%}
                </span>
                {%- if match -%}
                  {%- assign sum = sum | plus: match.price -%}
                  {%- assign found = found | plus: 1 -%}
                  <s class="bundle__price">{{ match.price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if gift_name != blank -%}
              <li class="bundle__item bundle__item--gift">
                <span class="bundle__thumb">{% render 'icon', name: 'gift', px: 22 %}</span>
                <span class="bundle__name"><strong>{{ gift_name }}</strong><small>De regalo con tu combo</small></span>
                <span class="bundle__free">GRATIS</span>
              </li>
            {%- endif -%}
          </ul>
          {%- if found == perfumes and sum > current_variant.price -%}
            {%- assign saved = sum | minus: current_variant.price -%}
            <div class="bundle__total">
              <p><span>Por separado</span> <s>{{ sum | money_without_trailing_zeros }}</s></p>
              <p class="bundle__now"><span>Con el 3x1</span> <strong>{{ current_variant.price | money_without_trailing_zeros }}</strong></p>
              <p class="bundle__save">Ahorrás {{ saved | money_without_trailing_zeros }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="variant-picker">
              <legend>{{ option.name }}: <strong data-option-label="{{ forloop.index0 }}">{{ option.selected_value }}</strong></legend>
              <div class="variant-picker__options">
                {%- for value in option.values -%}
                  <label class="variant-pill">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {%- if section.settings.show_quantity -%}
          <div class="qty">
            <button type="button" class="qty__btn" data-qty="-1" aria-label="Restar">{% render 'icon', name: 'minus', px: 16 %}</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad">
            <button type="button" class="qty__btn" data-qty="1" aria-label="Sumar">{% render 'icon', name: 'plus', px: 16 %}</button>
          </div>
        {%- endif -%}

        <button type="submit" name="add" class="button button--grad button--xl button--full" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
          <span data-add-label>{% if current_variant.available %}{{ section.settings.add_label }}{% else %}SIN STOCK{% endif %}</span>
        </button>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="product-form__buy-now">{{ form | payment_button }}</div>
        {%- endif -%}
        <p class="product-form__error" data-form-error hidden></p>
      {%- endform -%}

      {%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
        <a href="{{ wa_url | strip }}" class="button button--whatsapp button--full" target="_blank" rel="noopener">
          {% render 'icon', name: 'whatsapp', px: 18 %} {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}


      {%- if section.settings.show_trust -%}
        <ul class="trust-row">
          <li>{% render 'icon', name: 'check', px: 15 %} Pago seguro</li>
          <li>{% render 'icon', name: 'truck', px: 15 %} Envío gratis</li>
          <li>{% render 'icon', name: 'package', px: 15 %} Originales sellados</li>
        </ul>
      {%- endif -%}

      {%- if section.settings.quote_text != blank -%}
        <figure class="quote-card">
          <span class="quote-card__stars" aria-label="5 de 5 estrellas">★★★★★</span>
          <blockquote>“{{ section.settings.quote_text }}”</blockquote>
          <figcaption>{% render 'icon', name: 'check', px: 13 %} Cliente verificado{% if section.settings.quote_product != blank %} · <strong>{{ section.settings.quote_product }}</strong>{% endif %}</figcaption>
        </figure>
      {%- endif -%}

      {%- if is_combo == false and section.settings.show_upsell -%}
        {%- liquid
          assign my_name = product.title | split: ' · ' | first | strip | downcase
          assign shown = 0
          capture upsell_cards
            for p in collections.all.products
              if p.id == product.id
                continue
              endif
              assign p_tags = p.tags | join: ',' | downcase
              unless p_tags contains '3x1'
                continue
              endunless
              assign p_list = p.title | split: ' · ' | last
              assign p_items = p_list | split: ' + '
              assign has_me = false
              for it in p_items
                assign it_down = it | strip | downcase
                if it_down == my_name
                  assign has_me = true
                  break
                endif
              endfor
              unless has_me
                continue
              endunless
              assign shown = shown | plus: 1
              assign p_short = p.title | split: ' · ' | first
              assign p_rest = p_list | replace: ' + Mini perfumero', ' + mini de regalo'
              echo '<a class="upsell__card" href="' | append: p.url | append: '">'
              echo '<span class="upsell__thumb">'
              if p.featured_image
                echo p.featured_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: p_short
              endif
              echo '</span><span class="upsell__text"><strong>' | append: p_short | append: '</strong><small>' | append: p_rest | append: '</small><span class="upsell__price">'
              if p.compare_at_price > p.price
                assign p_compare = p.compare_at_price | money_without_trailing_zeros
                echo '<s>' | append: p_compare | append: '</s> '
              endif
              assign p_price = p.price | money_without_trailing_zeros
              echo '<b>' | append: p_price | append: '</b></span></span><span class="upsell__go" aria-hidden="true">→</span></a>'
              if shown >= 2
                break
              endif
            endfor
          endcapture
        -%}
        {%- if shown > 0 -%}
          <div class="upsell">
            {%- if section.settings.upsell_title != blank -%}<p class="upsell__head">{{ section.settings.upsell_title }}</p>{%- endif -%}
            {%- if section.settings.upsell_text != blank -%}<p class="upsell__sub">{{ section.settings.upsell_text }}</p>{%- endif -%}
            {{ upsell_cards }}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- liquid
        assign faq_count = 0
        for i in (1..4)
          assign qk = 'faq_q' | append: i
          if section.settings[qk] != blank
            assign faq_count = faq_count | plus: 1
          endif
        endfor
      -%}
      {%- if faq_count > 0 -%}
        <div class="product-faq">
          {%- for i in (1..4) -%}
            {%- assign qk = 'faq_q' | append: i -%}
            {%- assign ak = 'faq_a' | append: i -%}
            {%- if section.settings[qk] != blank -%}
              <details class="product-faq__item">
                <summary>{{ section.settings[qk] }}<span class="faq__icon">{% render 'icon', name: 'plus', px: 16 %}</span></summary>
                <div class="product-faq__answer">{% render 'cuotas-fix', t: section.settings[ak] %}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": {{ product.variants | json }},
      "installments": {{ count }},
      "installmentsMin": {{ min_cents }},
      "transferDiscount": {% if settings.transfer_show %}{{ pct }}{% else %}0{% endif %},
      "moneyFormat": {{ shop.money_format | json }},
      "addLabel": {{ section.settings.add_label | json }}
    }
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "class": "section-main-product",
  "settings": [
    { "type": "text", "id": "proof", "label": "Pastilla superior", "default": "Compra protegida · Envío gratis a todo el país", "info": "Usá solo datos reales (por ejemplo, cantidad de pedidos entregados)." },
    { "type": "text", "id": "add_label", "label": "Texto del botón de compra", "default": "AGREGAR AL CARRITO" },
    { "type": "text", "id": "shipping_text", "label": "Línea de envío", "default": "Envío gratis" },
    { "type": "richtext", "id": "pay_details", "label": "Detalle de medios de pago ('Ver más detalles')", "default": "<p>Tarjetas de crédito en 2 cuotas sin interés en compras desde $100.000. Débito, Mercado Pago y transferencia bancaria con 5% de descuento.</p>" },
    { "type": "checkbox", "id": "show_quantity", "label": "Mostrar selector de cantidad", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón 'Comprar ahora'", "default": false },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar botón de consulta por WhatsApp", "default": false },
    { "type": "text", "id": "whatsapp_label", "label": "Texto del botón de WhatsApp", "default": "Consultanos por WhatsApp" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar la descripción del producto", "default": true },
    { "type": "header", "content": "Prueba social" },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar fotos de clientes y estrellas debajo del título", "default": true, "info": "Al tocarlo baja a la sección de reseñas." },
    { "type": "text", "id": "social_text", "label": "Texto junto a las fotos", "default": "Clientes reales que ya recibieron su perfume" },
    { "type": "image_picker", "id": "social_img1", "label": "Foto de cliente 1 (opcional)" },
    { "type": "image_picker", "id": "social_img2", "label": "Foto de cliente 2 (opcional)" },
    { "type": "image_picker", "id": "social_img3", "label": "Foto de cliente 3 (opcional)" },
    { "type": "image_picker", "id": "social_img4", "label": "Foto de cliente 4 (opcional)" },
    { "type": "checkbox", "id": "show_trust", "label": "Mostrar sellos debajo del botón (pago seguro, envío gratis, originales)", "default": true },
    { "type": "textarea", "id": "quote_text", "label": "Reseña destacada debajo del botón", "default": "Muy bien perfume, de los mejores árabes que he probado, original.", "info": "Usá una reseña real, sin cambiar sus palabras. Vacío = no se muestra." },
    { "type": "text", "id": "quote_product", "label": "Perfume de la reseña destacada", "default": "Khamrah Qahwa" },
    { "type": "header", "content": "Combos 3x1: qué incluye" },
    { "type": "paragraph", "content": "En los productos con la etiqueta '3x1', arma la caja con los perfumes del nombre (lo que va después del '·', separado por ' + '), sus fotos y precios, el regalo y cuánto se ahorra." },
    { "type": "checkbox", "id": "show_bundle", "label": "Mostrar la caja del combo", "default": true },
    { "type": "text", "id": "bundle_title", "label": "Título de la caja", "default": "Tu combo incluye" },
    { "type": "header", "content": "Perfumes sueltos: ofrecer el 3x1" },
    { "type": "checkbox", "id": "show_upsell", "label": "Mostrar los combos que incluyen este perfume", "default": true },
    { "type": "text", "id": "upsell_title", "label": "Título", "default": "🎁 Llevalo en un 3x1 y ahorrá" },
    { "type": "text", "id": "upsell_text", "label": "Texto", "default": "Este perfume también viene en combo: 3 perfumes + mini perfumero de regalo." },
    { "type": "header", "content": "Preguntas frecuentes (debajo del botón)" },
    { "type": "paragraph", "content": "Dejá la pregunta vacía para ocultarla." },
    { "type": "text", "id": "faq_q1", "label": "Pregunta 1", "default": "⭐ ¿Es confiable comprar en Casa del Oud?" },
    { "type": "richtext", "id": "faq_a1", "label": "Respuesta 1", "default": "<p>Sí. Pagás con Mercado Pago o tarjeta a través del checkout seguro de Shopify, y te mandamos el seguimiento de tu envío. Ante cualquier duda, escribinos por WhatsApp.</p>" },
    { "type": "text", "id": "faq_q2", "label": "Pregunta 2", "default": "🚚 ¿Cuánto tarda el envío?" },
    { "type": "richtext", "id": "faq_a2", "label": "Respuesta 2", "default": "<p>Despachamos en 24 hs hábiles y el envío es gratis a todo el país. El tiempo de entrega depende de tu ciudad; te pasamos el código de seguimiento apenas sale.</p>" },
    { "type": "text", "id": "faq_q3", "label": "Pregunta 3", "default": "⏱ ¿Cuánto duran los perfumes?" },
    { "type": "richtext", "id": "faq_a3", "label": "Respuesta 3", "default": "<p>Depende de la fragancia y de tu piel, pero en general entre 8 y 12 horas en piel, y más en la ropa.</p>" },
    { "type": "text", "id": "faq_q4", "label": "Pregunta 4", "default": "💳 ¿Puedo pagar en cuotas?" },
    { "type": "richtext", "id": "faq_a4", "label": "Respuesta 4", "default": "<p>Sí, tenés 2 cuotas sin interés con tarjeta de crédito en compras desde $100.000. Y si pagás por transferencia, tenés 5% de descuento.</p>" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}

<section class="section">
  <div class="page-width">
    {% render 'section-heading', eyebrow: 'BLOG', title: blog.title, tag: 'h1' %}

    {%- paginate blog.articles by 9 -%}
      <div class="collection-list">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="collection-tile card">
            {%- if article.image -%}
              <div class="collection-tile__media">
                {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 750px) 33vw, 100vw' }}
              </div>
            {%- endif -%}
            <div class="collection-tile__body collection-tile__body--stack">
              <small>{{ article.published_at | date: '%d/%m/%Y' }}</small>
              <h2>{{ article.title }}</h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
  ]
}
{% endschema %}

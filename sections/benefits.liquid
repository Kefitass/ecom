<section class="section" style="--section-bg: {{ section.settings.background }};">
  <div class="page-width">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle
    %}

    <div class="benefits">
      {%- for block in section.blocks -%}
        <div class="benefit card" {{ block.shopify_attributes }}>
          <span class="benefit__icon">{% render 'icon', name: block.settings.icon, px: 26 %}</span>
          <h3>{{ block.settings.title }}</h3>
          <div class="benefit__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "class": "section-benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "¿POR QUÉ ELEGIRNOS?" },
    { "type": "text", "id": "title", "label": "Título", "default": "La perfumería de siempre, con aromas de Oriente" },
    { "type": "richtext", "id": "subtitle", "label": "Subtítulo" },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#f3f1ef" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "sparkles",
          "options": [
            { "value": "sparkles", "label": "Brillos" },
            { "value": "clock", "label": "Reloj" },
            { "value": "droplet", "label": "Gota" },
            { "value": "heart", "label": "Corazón" },
            { "value": "shield", "label": "Escudo" },
            { "value": "chat", "label": "Chat" },
            { "value": "gift", "label": "Regalo" },
            { "value": "home", "label": "Casa" },
            { "value": "truck", "label": "Camión" },
            { "value": "card", "label": "Tarjeta" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "100% originales" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Trabajamos con distribuidores oficiales de cada marca.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Beneficios",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "sparkles", "title": "100% originales", "text": "<p>Perfumes sellados de las casas árabes más buscadas, sin imitaciones.</p>" } },
        { "type": "benefit", "settings": { "icon": "clock", "title": "Duran todo el día", "text": "<p>Las fragancias árabes son famosas por su fijación y estela: te acompañan de la mañana a la noche.</p>" } },
        { "type": "benefit", "settings": { "icon": "home", "title": "Trato de barrio", "text": "<p>Te asesoramos por WhatsApp como en la perfumería de la esquina, para que aciertes con tu aroma.</p>" } }
      ]
    }
  ]
}
{% endschema %}

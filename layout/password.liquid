<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
    -%}
    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --c-primary: {{ settings.color_primary }};
        --c-primary-dark: {{ settings.color_primary | color_darken: 8 }};
        --c-accent: {{ settings.color_accent }};
        --c-accent-dark: {{ settings.color_accent | color_darken: 8 }};
        --c-heading: {{ settings.color_heading }};
        --c-text: {{ settings.color_text }};
        --c-bg: {{ settings.color_background }};
        --c-surface: {{ settings.color_surface }};
        --c-border: {{ settings.color_heading | color_modify: 'alpha', 0.1 }};
        --radius: {{ settings.card_radius }}px;
        --page-width: 1200px;
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

{% comment %}
  VERDEA · Pie de página + botón flotante de WhatsApp
  Instalación: Editar código → Sections → "Agregar una nueva sección" → nombre: verdea-footer
  → borrar todo lo que trae → pegar este archivo → Guardar.
  Después: Personalizar → Pie de página → Agregar sección → "VERDEA · Pie de página".
{% endcomment %}

{%- liquid
  assign p = all_products['enraizante-organico-para-huerta-y-macetas-250-ml']
  assign wa = section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = section.settings.whatsapp_mensaje | url_encode
  assign wa_url = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_msg
  assign mail = section.settings.email | default: 'gardenfreeportfolio@gmail.com'
-%}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

<style>
  #vf-{{ section.id }}{
    --vf-green:#2A5F35;--vf-sprout:#6BA342;--vf-cream:#F5F4EE;--vf-earth:#4E382A;
    background:#21492A;color:rgba(255,255,255,.82);font-family:'Open Sans','Lato',sans-serif;font-size:14.5px;line-height:1.6;
    position:relative;overflow:hidden;
  }
  #vf-{{ section.id }} *{box-sizing:border-box}
  #vf-{{ section.id }}:before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(circle at 8% 0%,rgba(107,163,66,.22),transparent 40%),radial-gradient(circle at 100% 100%,rgba(107,163,66,.14),transparent 45%)}
  #vf-{{ section.id }} a{color:rgba(255,255,255,.82);text-decoration:none;transition:color .2s}
  #vf-{{ section.id }} a:hover{color:#fff}
  .vf-wrap{max-width:1160px;margin:0 auto;padding:0 20px;position:relative}
  .vf-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.3fr;gap:40px;padding:56px 0 40px}
  .vf-logo{display:inline-flex;background:#fff;border-radius:18px;padding:10px 14px;margin-bottom:16px}
  .vf-logo img{display:block;width:auto;height:auto;max-height:84px;max-width:150px}
  .vf-brandname{font-family:'Poppins','Montserrat',sans-serif;font-weight:800;font-size:26px;color:#fff;letter-spacing:.02em;margin-bottom:10px}
  .vf-tag{font-family:'Poppins','Montserrat',sans-serif;font-weight:600;color:#fff;font-size:16px;margin:0 0 8px}
  .vf-desc{margin:0;max-width:300px}
  .vf-social{display:flex;gap:10px;margin-top:18px}
  #vf-{{ section.id }} .vf-social a{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;transition:background .2s,transform .2s}
  #vf-{{ section.id }} .vf-social a:hover{background:var(--vf-sprout);transform:translateY(-2px)}
  .vf-social svg{width:18px;height:18px;fill:#fff}
  .vf-h{font-family:'Poppins','Montserrat',sans-serif;font-weight:700;font-size:15px;color:#fff;margin:6px 0 16px;letter-spacing:.02em}
  .vf-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .vf-contact li{display:flex;gap:10px;align-items:flex-start}
  .vf-contact svg{width:18px;height:18px;flex:none;margin-top:2px;color:var(--vf-sprout)}
  #vf-{{ section.id }} .vf-wa-cta{display:inline-flex;align-items:center;gap:8px;margin-top:16px;background:#25D366;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:14px;padding:10px 18px;border-radius:999px;box-shadow:0 6px 16px rgba(0,0,0,.18)}
  #vf-{{ section.id }} .vf-wa-cta:hover{background:#1ebe5b;color:#fff}
  .vf-wa-cta svg{width:18px;height:18px;fill:#fff}
  .vf-bottom{border-top:1px solid rgba(255,255,255,.12);padding:20px 0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px}
  .vf-pay{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}
  .vf-pay svg{width:38px;height:24px;display:block;border-radius:4px}
  body:has(#wigy-sticky-atc.visible) #vf-{{ section.id }} .vf-bottom{padding-bottom:100px}

  @media (max-width:989px){
    .vf-top{grid-template-columns:1fr 1fr;gap:32px 24px}
    .vf-brand,.vf-contactcol{grid-column:1/-1}
  }
  @media (max-width:749px){
    .vf-top{padding:44px 0 28px;gap:28px 20px}
    .vf-bottom{flex-direction:column;align-items:flex-start}
  }

  /* Menú del encabezado: página activa legible (letras verdes + rayita) */
  .header__inline-menu .header__menu-item[aria-current="page"],
  .header__inline-menu .header__menu-item .header__active-menu-item,
  .menu-drawer__menu-item--active{background:transparent!important;color:#2A5F35!important;box-shadow:none!important}
  .header__inline-menu .header__menu-item .header__active-menu-item,
  .header__inline-menu .header__menu-item[aria-current="page"] span{text-decoration:underline!important;text-decoration-color:#6BA342!important;text-decoration-thickness:2px!important;text-underline-offset:7px!important;font-weight:600}

  /* Botón flotante de WhatsApp */
  .vf-float{position:fixed;right:20px;bottom:20px;z-index:9990;display:flex;align-items:center;gap:10px;transition:bottom .35s ease}
  .vf-float__btn{width:58px;height:58px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;
    box-shadow:0 8px 24px rgba(37,211,102,.4),0 2px 6px rgba(0,0,0,.15);transition:transform .2s;position:relative}
  .vf-float__btn:before{content:"";position:absolute;inset:0;border-radius:50%;background:#25D366;opacity:.5;animation:vfPulse 2.4s ease-out infinite;z-index:-1}
  .vf-float__btn:hover{transform:scale(1.07)}
  .vf-float__btn svg{width:30px;height:30px;fill:#fff}
  .vf-float__tip{background:#fff;color:#4E382A;font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;padding:8px 14px;border-radius:999px;
    box-shadow:0 6px 18px rgba(0,0,0,.12);white-space:nowrap;opacity:0;transform:translateX(8px);transition:opacity .25s,transform .25s;pointer-events:none}
  .vf-float:hover .vf-float__tip{opacity:1;transform:none}
  body:has(#wigy-sticky-atc.visible) .vf-float{bottom:100px}
  @keyframes vfPulse{0%{transform:scale(1);opacity:.5}70%,100%{transform:scale(1.55);opacity:0}}
  @media (max-width:749px){
    .vf-float{right:14px;bottom:16px}
    .vf-float__btn{width:52px;height:52px}
    .vf-float__btn svg{width:27px;height:27px}
    .vf-float__tip{display:none}
    body:has(#wigy-sticky-atc.visible) .vf-float{bottom:92px}
  }
  @media (prefers-reduced-motion:reduce){.vf-float__btn:before{animation:none}}
</style>

{%- capture wa_svg -%}<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.04 3C9 3 3.3 8.7 3.3 15.73c0 2.25.59 4.44 1.7 6.37L3.2 28.8l6.87-1.8a12.7 12.7 0 0 0 5.97 1.52h.01c7.03 0 12.74-5.7 12.74-12.74 0-3.4-1.33-6.6-3.73-9A12.66 12.66 0 0 0 16.04 3zm0 23.37h-.01c-1.9 0-3.77-.51-5.4-1.48l-.39-.23-4.08 1.07 1.09-3.97-.25-.41a10.56 10.56 0 0 1-1.62-5.62c0-5.84 4.75-10.6 10.6-10.6 2.83 0 5.49 1.1 7.49 3.11a10.53 10.53 0 0 1 3.1 7.5c0 5.84-4.76 10.6-10.53 10.6zm5.81-7.94c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.32-.82 1.03-1 1.24-.19.21-.37.24-.69.08-.32-.16-1.34-.5-2.56-1.58-.95-.85-1.59-1.89-1.77-2.21-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65s1.14 3.08 1.3 3.29c.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.88-.77 2.14-1.51.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.61-.37z"/></svg>{%- endcapture -%}

<footer id="vf-{{ section.id }}">
  <div class="vf-wrap">
    <div class="vf-top">
      <div class="vf-brand">
        {%- assign logo = section.settings.logo | default: settings.logo -%}
        {%- if logo != blank -%}
          <a class="vf-logo" href="{{ routes.root_url }}">{{ logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'lazy' }}</a>
        {%- else -%}
          <div class="vf-brandname">{{ shop.name }}</div>
        {%- endif -%}
        <p class="vf-tag">{{ section.settings.lema }}</p>
        <p class="vf-desc">{{ section.settings.descripcion }}</p>
        {%- if section.settings.instagram != blank or section.settings.facebook != blank or section.settings.tiktok != blank -%}
        <div class="vf-social">
          {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.58 0 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.2 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85C2.42 3.92 3.94 2.42 7.15 2.27 8.42 2.2 8.8 2.2 12 2.2zm0 4.86a4.94 4.94 0 1 0 0 9.88 4.94 4.94 0 0 0 0-9.88zm0 8.15a3.21 3.21 0 1 1 0-6.42 3.21 3.21 0 0 1 0 6.42zm5.14-9.5a1.15 1.15 0 1 0 0 2.3 1.15 1.15 0 0 0 0-2.3z"/></svg></a>{%- endif -%}
          {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M13.5 21.9v-7.5h2.5l.4-2.9h-2.9V9.6c0-.85.24-1.42 1.46-1.42h1.55V5.57c-.27-.04-1.19-.12-2.26-.12-2.24 0-3.77 1.37-3.77 3.87v2.16H8v2.9h2.5v7.5z"/></svg></a>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.62c.27 0 .53.04.78.12V9.75a5.7 5.7 0 0 0-.78-.05 5.68 5.68 0 1 0 5.68 5.68V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.3 4.3 0 0 1-3.24-1.48z"/></svg></a>{%- endif -%}
        </div>
        {%- endif -%}
      </div>

      <div>
        <p class="vf-h">Tienda</p>
        <ul class="vf-list">
          <li><a href="{{ routes.root_url }}">Inicio</a></li>
          {%- if p != blank -%}<li><a href="{{ p.url }}">Enraizante Orgánico 250 ml</a></li>{%- endif -%}
          <li><a href="{{ routes.all_products_collection_url }}">Catálogo</a></li>
          <li><a href="{{ routes.cart_url }}">Mi carrito</a></li>
        </ul>
      </div>

      <div>
        <p class="vf-h">Ayuda</p>
        <ul class="vf-list">
          <li><a href="/pages/contact">Contacto</a></li>
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="vf-contactcol">
        <p class="vf-h">Contacto</p>
        <ul class="vf-list vf-contact">
          {%- if wa != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.4A8.5 8.5 0 1 1 21 12z"/></svg><a href="{{ wa_url }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_visible }}</a></li>
          {%- endif -%}
          {%- if mail != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href="mailto:{{ mail }}">{{ mail }}</a></li>
          {%- endif -%}
          {%- if section.settings.horario != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{ section.settings.horario }}</span></li>
          {%- endif -%}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg><span>Envíos a todo el país</span></li>
        </ul>
        {%- if wa != blank -%}
          <a class="vf-wa-cta" href="{{ wa_url }}" target="_blank" rel="noopener">{{ wa_svg }} Escribinos por WhatsApp</a>
        {%- endif -%}
      </div>
    </div>

    <div class="vf-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Todos los derechos reservados</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="vf-pay" aria-label="Medios de pago">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- if section.settings.whatsapp_flotante and wa != blank -%}
  <div class="vf-float">
    <span class="vf-float__tip">{{ section.settings.whatsapp_tip }}</span>
    <a class="vf-float__btn" href="{{ wa_url }}" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">{{ wa_svg }}</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "VERDEA · Pie de página",
  "tag": "div",
  "class": "verdea-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional)", "info": "Si no elegís uno, se usa el logo del tema." },
    { "type": "text", "id": "lema", "label": "Lema", "default": "Tu rincón verde, tu momento de paz 🌱" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción", "default": "Productos orgánicos para que tu huerta y tus plantas crezcan fuertes desde la raíz." },
    { "type": "header", "content": "Contacto" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (solo números, con 549)", "default": "5491139448089", "info": "Formato Argentina: 549 + código de área sin 0 + número sin 15." },
    { "type": "text", "id": "whatsapp_visible", "label": "WhatsApp (como se muestra)", "default": "+54 9 11 3944-8089" },
    { "type": "text", "id": "whatsapp_mensaje", "label": "Mensaje que se escribe solo", "default": "¡Hola VERDEA! 🌱 Tengo una consulta sobre el enraizante." },
    { "type": "text", "id": "email", "label": "Email", "default": "gardenfreeportfolio@gmail.com", "info": "Mail que se muestra en el pie de página." },
    { "type": "text", "id": "horario", "label": "Horario de atención", "default": "Lunes a viernes de 9 a 18 hs" },
    { "type": "header", "content": "Botón flotante de WhatsApp" },
    { "type": "checkbox", "id": "whatsapp_flotante", "label": "Mostrar botón flotante", "default": true },
    { "type": "text", "id": "whatsapp_tip", "label": "Texto al pasar el mouse", "default": "¿Dudas? Escribinos 👋" },
    { "type": "header", "content": "Redes sociales" },
    { "type": "text", "id": "instagram", "label": "Instagram (link)", "default": "https://www.instagram.com/huerta.verdea/" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "tiktok", "label": "TikTok" }
  ],
  "presets": [{ "name": "VERDEA · Pie de página" }]
}
{% endschema %}

{% comment %}
  VERDEA · Página de inicio (sección nativa de Shopify)
  Instalación: Editar código → Sections → "Agregar una nueva sección" → nombre: verdea-inicio
  → borrar todo lo que trae → pegar este archivo → Guardar.
  Después: Personalizar → Página de inicio → Agregar sección → "VERDEA · Inicio".
  Todo lo editable (textos, fotos, testimonios, preguntas) se cambia desde el editor.
{% endcomment %}

{%- liquid
  assign p = section.settings.producto
  if p == blank
    assign p = all_products['enraizante-organico-para-huerta-y-macetas-250-ml']
  endif
  assign url_producto = p.url | default: '/collections/all'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  #vh-{{ section.id }}{
    --vh-green:#2A5F35;--vh-sprout:#6BA342;--vh-orange:#E88031;--vh-cream:#F5F4EE;--vh-white:#FFFFFF;--vh-earth:#4E382A;
    --vh-text:#4E382A;--vh-muted:#6E6157;--vh-line:#E5E2D6;
    --vh-title:'Poppins','Montserrat',sans-serif;--vh-body:'Open Sans','Lato',sans-serif;
    background:var(--vh-cream);color:var(--vh-text);font-family:var(--vh-body);
    overflow:hidden;
  }
  #vh-{{ section.id }} *{box-sizing:border-box;letter-spacing:normal}
  #vh-{{ section.id }}{line-height:1.55}
  #vh-{{ section.id }} .vh-trust__item b,#vh-{{ section.id }} .vh-pack b{line-height:1.3}
  #vh-{{ section.id }} .vh-trust__item span,#vh-{{ section.id }} .vh-pack span,#vh-{{ section.id }} .vh-pill,#vh-{{ section.id }} .vh-hero__rating{line-height:1.35}
  #vh-{{ section.id }} .vh-kicker{letter-spacing:.08em}
  #vh-{{ section.id }} img{max-width:100%;height:auto;display:block}
  #vh-{{ section.id }} h1,#vh-{{ section.id }} h2,#vh-{{ section.id }} h3{font-family:var(--vh-title);color:var(--vh-earth);margin:0;letter-spacing:0}
  #vh-{{ section.id }} p{margin:0}
  .vh-wrap{max-width:1160px;margin:0 auto;padding:0 20px}
  .vh-sec{padding:64px 0}
  .vh-sec--white{background:var(--vh-white)}
  .vh-head{text-align:center;max-width:640px;margin:0 auto 36px}
  .vh-kicker{display:inline-block;font-family:var(--vh-title);font-weight:600;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--vh-sprout);margin-bottom:10px}
  .vh-h2{font-size:clamp(26px,3.2vw,36px);font-weight:700;line-height:1.2}
  .vh-h2 em{font-style:normal;color:var(--vh-green)}
  .vh-lead{font-size:16px;line-height:1.6;color:var(--vh-muted);margin-top:12px!important}

  /* Botones */
  .vh-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 34px;border-radius:999px;
    background:var(--vh-green);color:#fff!important;font-family:var(--vh-title);font-weight:700;font-size:16px;text-decoration:none!important;
    box-shadow:0 8px 20px rgba(42,95,53,.25);transition:transform .2s,box-shadow .2s,background .2s;border:0}
  .vh-btn:hover{background:#224e2b;transform:translateY(-2px);box-shadow:0 12px 26px rgba(42,95,53,.32)}
  .vh-btn svg{width:18px;height:18px;transition:transform .2s}
  .vh-btn:hover svg{transform:translateX(4px)}
  .vh-btn--orange{background:var(--vh-orange);box-shadow:0 8px 20px rgba(232,128,49,.3)}
  .vh-btn--orange:hover{background:#d4701f;box-shadow:0 12px 26px rgba(232,128,49,.38)}
  .vh-stars{display:inline-flex;gap:2px;color:#F4B400}
  .vh-stars svg{width:16px;height:16px}

  /* 1 · Portada */
  .vh-hero{padding:56px 0 64px}
  .vh-hero__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  .vh-pill{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--vh-line);border-radius:999px;padding:7px 14px;font-size:13px;font-weight:600;color:var(--vh-green)}
  .vh-pill b{color:var(--vh-earth)}
  .vh-h1{font-size:clamp(34px,4.6vw,54px);font-weight:800;line-height:1.08;margin:18px 0 16px!important}
  .vh-h1 em{font-style:normal;color:var(--vh-green);position:relative;white-space:nowrap}
  .vh-h1 em:after{content:"";position:absolute;left:0;right:0;bottom:.04em;height:.22em;background:rgba(107,163,66,.28);border-radius:4px;z-index:-1}
  .vh-hero__sub{font-size:17px;line-height:1.6;color:var(--vh-muted);max-width:520px}
  .vh-hero__cta{display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:28px}
  .vh-hero__rating{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--vh-muted)}
  .vh-hero__rating b{color:var(--vh-earth)}
  .vh-hero__checks{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:26px;padding:0;list-style:none}
  .vh-hero__checks li{display:flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:var(--vh-earth)}
  .vh-hero__checks svg{width:18px;height:18px;color:var(--vh-sprout);flex:none}
  .vh-hero__media{position:relative;display:flex;justify-content:center}
  .vh-hero__blob{position:absolute;inset:6% 4%;background:radial-gradient(circle at 50% 45%,#fff 0,#E9EFDF 55%,rgba(233,239,223,0) 72%);border-radius:50%}
  .vh-hero__img{position:relative;width:100%;max-width:480px;aspect-ratio:1/1;object-fit:contain;filter:drop-shadow(0 24px 30px rgba(78,56,42,.18))}
  .vh-hero__img--cover{object-fit:cover;border-radius:28px;filter:none;box-shadow:0 24px 50px rgba(78,56,42,.18)}
  .vh-hero__badge{position:absolute;right:4%;top:8%;background:var(--vh-orange);color:#fff;font-family:var(--vh-title);font-weight:800;font-size:15px;line-height:1.1;text-align:center;width:96px;height:96px;border-radius:50%;
    display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(8deg);box-shadow:0 10px 22px rgba(232,128,49,.35)}
  .vh-hero__badge small{font-size:11px;font-weight:600;opacity:.95}

  /* 2 · Barra de confianza */
  .vh-trust{background:var(--vh-green);color:#fff;padding:22px 0}
  .vh-trust__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .vh-trust__item{display:flex;align-items:center;justify-content:center;gap:12px;text-align:left}
  .vh-trust__ico{width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;flex:none}
  .vh-trust__ico svg{width:22px;height:22px;color:#fff}
  .vh-trust__item b{display:block;font-family:var(--vh-title);font-size:15px;font-weight:700;color:#fff}
  .vh-trust__item span{font-size:13px;opacity:.85}

  /* 3 · Producto destacado */
  .vh-prod{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#fff;border:1px solid var(--vh-line);border-radius:28px;overflow:hidden;box-shadow:0 18px 40px rgba(78,56,42,.08)}
  .vh-prod__media{background:linear-gradient(160deg,#EEF3E6,#F5F4EE);display:block;padding:0;position:relative;overflow:hidden;min-height:100%}
  #vh-{{ section.id }} .vh-prod__media img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;transition:transform .6s ease}
  .vh-prod__media:hover img{transform:scale(1.03)}
  .vh-prod__tag{z-index:1;position:absolute;left:20px;top:20px;background:var(--vh-sprout);color:#fff;font-family:var(--vh-title);font-weight:700;font-size:12px;padding:6px 12px;border-radius:999px;letter-spacing:.04em}
  .vh-prod__body{padding:40px 44px;display:flex;flex-direction:column;justify-content:center}
  .vh-prod__title{font-size:clamp(22px,2.4vw,28px);font-weight:700;line-height:1.25}
  .vh-prod__rating{display:flex;align-items:center;gap:8px;margin:10px 0 16px;font-size:14px;color:var(--vh-muted)}
  .vh-prod__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px}
  .vh-prod__price strong{font-family:var(--vh-title);font-size:30px;font-weight:800;color:var(--vh-earth)}
  .vh-prod__price s{color:#9a8f86;font-size:17px}
  .vh-prod__cuotas{font-size:14px;color:var(--vh-green);font-weight:600;margin-top:4px!important}
  .vh-prod__list{list-style:none;padding:0;margin:20px 0!important;display:grid;gap:10px}
  .vh-prod__list li{display:flex;gap:10px;align-items:flex-start;font-size:15px;line-height:1.45}
  .vh-prod__list svg{width:20px;height:20px;color:var(--vh-sprout);flex:none;margin-top:1px}
  .vh-packs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px}
  #vh-{{ section.id }} .vh-pack{display:block;border:1.5px solid var(--vh-line)!important;border-radius:14px;padding:12px 14px 12px 40px;position:relative;background:var(--vh-cream)!important;text-align:left;cursor:pointer;margin:0;
    transition:border-color .2s,background .2s,box-shadow .2s,transform .15s;-webkit-tap-highlight-color:transparent;user-select:none}
  #vh-{{ section.id }} .vh-pack:hover{border-color:#d9c9b5!important}
  #vh-{{ section.id }} .vh-pack:active{transform:scale(.98)}
  #vh-{{ section.id }} .vh-pack input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
  #vh-{{ section.id }} .vh-pack__dot{position:absolute;left:14px;top:50%;width:16px;height:16px;margin-top:-8px;border-radius:50%;border:2px solid #cfc6b8;background:#fff;box-sizing:border-box;transition:border .2s}
  #vh-{{ section.id }} .vh-pack.is-sel,#vh-{{ section.id }} .vh-pack:has(input:checked){border-color:var(--vh-orange)!important;background:#FFF7F0!important;box-shadow:0 6px 16px rgba(232,128,49,.16)}
  #vh-{{ section.id }} .vh-pack.is-sel .vh-pack__dot,#vh-{{ section.id }} .vh-pack:has(input:checked) .vh-pack__dot{border:5px solid var(--vh-orange)}
  #vh-{{ section.id }} .vh-pack:has(input:focus-visible){outline:2px solid var(--vh-green);outline-offset:2px}
  .vh-pack b{display:block;font-family:var(--vh-title);font-size:14px;color:var(--vh-earth)}
  .vh-pack span{font-size:12.5px;color:var(--vh-muted)}
  #vh-{{ section.id }} .vh-pack > span:not(.vh-pack__dot){display:block;margin-top:2px}
  #vh-{{ section.id }} .vh-pack{line-height:1.35}
  .vh-pack i{position:absolute;top:-10px;right:10px;background:var(--vh-orange);color:#fff;font-style:normal;font-family:var(--vh-title);font-weight:700;font-size:11px;padding:3px 9px;border-radius:999px}
  .vh-prod .vh-btn{width:100%}

  /* 4 · Beneficios */
  .vh-ben{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vh-card{background:#fff;border:1px solid var(--vh-line);border-radius:22px;padding:30px 26px;transition:transform .25s,box-shadow .25s}
  .vh-card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(78,56,42,.09)}
  .vh-card__ico{width:54px;height:54px;border-radius:16px;background:#EEF4E6;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .vh-card__ico svg{width:28px;height:28px;color:var(--vh-green)}
  .vh-card h3{font-size:18px;font-weight:700;margin-bottom:8px!important}
  .vh-card p{font-size:15px;line-height:1.6;color:var(--vh-muted)}
  .vh-compare{margin-top:40px;border-radius:24px;overflow:hidden;border:1px solid var(--vh-line);background:#fff}
  .vh-compare img{width:100%;height:auto}

  /* 5 · Cómo se usa */
  .vh-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;counter-reset:vhstep;position:relative}
  .vh-step{text-align:center;padding:0 10px;position:relative}
  .vh-step__n{width:64px;height:64px;margin:0 auto 18px;border-radius:50%;background:var(--vh-green);color:#fff;font-family:var(--vh-title);font-weight:800;font-size:24px;
    display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 8px #E6EEDD;position:relative;z-index:1}
  .vh-step:not(:last-child):after{content:"";position:absolute;top:32px;left:calc(50% + 48px);right:calc(-50% + 48px);border-top:2px dashed #BFD3AE}
  .vh-step h3{font-size:18px;font-weight:700;margin-bottom:8px!important}
  .vh-step p{font-size:15px;line-height:1.6;color:var(--vh-muted);max-width:300px;margin:0 auto!important}

  /* 6 · Testimonios */
  .vh-revs{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .vh-rev{background:#fff;border:1px solid var(--vh-line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column}
  .vh-rev__img{aspect-ratio:1/1;width:100%;object-fit:cover;background:#EEF4E6}
  .vh-rev__body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
  .vh-rev h3{font-size:16px;font-weight:700;line-height:1.3}
  .vh-rev p{font-size:14px;line-height:1.55;color:var(--vh-muted);flex:1}
  .vh-rev__who{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--vh-earth);margin-top:4px}
  .vh-rev__who svg{width:16px;height:16px;color:var(--vh-sprout)}
  .vh-rev__who span{font-weight:600;color:var(--vh-sprout)}

  /* 7 · Preguntas */
  .vh-faq{max-width:780px;margin:0 auto;display:grid;gap:12px}
  .vh-faq details{background:#fff;border:1px solid var(--vh-line);border-radius:16px;overflow:hidden}
  .vh-faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;font-family:var(--vh-title);font-weight:600;font-size:16px;color:var(--vh-earth)}
  .vh-faq summary::-webkit-details-marker{display:none}
  .vh-faq summary::after{content:"";display:none}
  .vh-faq__plus{width:28px;height:28px;border-radius:50%;background:#EEF4E6;flex:none;position:relative;transition:transform .25s,background .25s}
  .vh-faq__plus:before,.vh-faq__plus:after{content:"";position:absolute;left:50%;top:50%;width:12px;height:2px;background:var(--vh-green);transform:translate(-50%,-50%);border-radius:2px}
  .vh-faq__plus:after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .25s}
  .vh-faq details[open] .vh-faq__plus{background:var(--vh-green)}
  .vh-faq details[open] .vh-faq__plus:before,.vh-faq details[open] .vh-faq__plus:after{background:#fff}
  .vh-faq details[open] .vh-faq__plus:after{transform:translate(-50%,-50%) rotate(0deg)}
  .vh-faq__a{padding:0 22px 20px;font-size:15px;line-height:1.65;color:var(--vh-muted)}

  /* 8 · Cierre */
  .vh-final{background:var(--vh-green);color:#fff;text-align:center;padding:64px 0;position:relative}
  .vh-final:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 15% 20%,rgba(107,163,66,.35),transparent 45%),radial-gradient(circle at 85% 80%,rgba(107,163,66,.25),transparent 45%)}
  .vh-final .vh-wrap{position:relative}
  #vh-{{ section.id }} .vh-final h2{color:#fff;font-size:clamp(26px,3.4vw,38px);font-weight:800;line-height:1.2}
  .vh-final p{opacity:.9;font-size:16px;margin:12px auto 28px!important;max-width:560px;line-height:1.6}
  .vh-final small{display:block;margin-top:16px;font-size:13px;opacity:.8}

  /* Animación suave al aparecer */
  .vh-reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
  .vh-reveal.is-in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.vh-reveal{opacity:1;transform:none;transition:none}}

  /* Tablet */
  @media (max-width:989px){
    .vh-hero__grid{grid-template-columns:1fr;gap:28px;text-align:center}
    .vh-hero__media{order:-1}
    .vh-hero__img{max-width:340px}
    .vh-hero__sub{margin:0 auto}
    .vh-hero__cta,.vh-hero__checks{justify-content:center}
    .vh-trust__grid{grid-template-columns:repeat(2,1fr);gap:18px 12px}
    .vh-trust__item{justify-content:flex-start}
    .vh-prod{grid-template-columns:1fr}
    .vh-prod__media{aspect-ratio:1/1;min-height:0}
    .vh-prod__body{padding:28px 24px 30px}
    .vh-ben{grid-template-columns:1fr;max-width:560px;margin:0 auto}
    .vh-revs{grid-template-columns:repeat(2,1fr)}
  }
  /* Celular */
  @media (max-width:749px){
    .vh-sec{padding:48px 0}
    .vh-hero{padding:28px 0 44px}
    .vh-hero__img{max-width:270px}
    .vh-hero__badge{width:78px;height:78px;font-size:13px;right:2%}
    .vh-hero__sub{font-size:16px}
    .vh-hero__cta .vh-btn{width:100%}
    .vh-hero__cta{gap:12px}
    .vh-hero__checks{gap:8px 14px}
    .vh-hero__checks li{font-size:13px}
    .vh-trust__item b{font-size:13.5px}
    .vh-trust__item span{font-size:12px}
    .vh-trust__ico{width:36px;height:36px}
    .vh-trust__ico svg{width:19px;height:19px}
    .vh-steps{grid-template-columns:1fr;gap:30px}
    .vh-step:not(:last-child):after{display:none}
    .vh-revs{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin:0 -20px;padding:4px 20px 12px;scrollbar-width:none}
    .vh-revs::-webkit-scrollbar{display:none}
    .vh-rev{flex:0 0 78%;scroll-snap-align:center}
    .vh-faq summary{padding:16px 18px;font-size:15px}
    .vh-faq__a{padding:0 18px 18px}
    .vh-final .vh-btn{width:100%}
  }
</style>

{%- capture vh_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture vh_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture vh_star -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>{%- endcapture -%}
{%- capture vh_stars -%}<span class="vh-stars" aria-label="5 estrellas">{{ vh_star }}{{ vh_star }}{{ vh_star }}{{ vh_star }}{{ vh_star }}</span>{%- endcapture -%}

<div id="vh-{{ section.id }}">

  {%- comment -%} 1 · PORTADA {%- endcomment -%}
  <section class="vh-hero">
    <div class="vh-wrap vh-hero__grid">
      <div class="vh-reveal">
        {%- if section.settings.etiqueta != blank -%}
          <span class="vh-pill">🌱 {{ section.settings.etiqueta }}</span>
        {%- endif -%}
        <h1 class="vh-h1">{{ section.settings.titulo }}</h1>
        <p class="vh-hero__sub">{{ section.settings.subtitulo }}</p>
        <div class="vh-hero__cta">
          <a class="vh-btn" href="{{ url_producto }}">{{ section.settings.boton }} {{ vh_arrow }}</a>
          <div class="vh-hero__rating">{{ vh_stars }} <span><b>{{ section.settings.puntuacion }}</b> · {{ section.settings.texto_clientes }}</span></div>
        </div>
        <ul class="vh-hero__checks">
          <li>{{ vh_check }} 100% orgánico</li>
          <li>{{ vh_check }} Apto huerta</li>
          <li>{{ vh_check }} Fácil de usar</li>
        </ul>
      </div>
      <div class="vh-hero__media vh-reveal">
        {%- if section.settings.hero_imagen != blank -%}
          {{ section.settings.hero_imagen | image_url: width: 1200 | image_tag: class: 'vh-hero__img vh-hero__img--cover', loading: 'eager', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 480px, 90vw', alt: section.settings.titulo }}
        {%- elsif p.featured_image -%}
          <div class="vh-hero__blob"></div>
          {{ p.featured_image | image_url: width: 1000 | image_tag: class: 'vh-hero__img', loading: 'eager', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 480px, 80vw', alt: p.title }}
        {%- endif -%}
        {%- if section.settings.badge_top != blank -%}
          <div class="vh-hero__badge">{{ section.settings.badge_top }}<small>{{ section.settings.badge_bottom }}</small></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} 2 · BARRA DE CONFIANZA {%- endcomment -%}
  <section class="vh-trust">
    <div class="vh-wrap vh-trust__grid">
      <div class="vh-trust__item"><span class="vh-trust__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></span><div><b>Despacho en 24 hs</b><span>A todo el país</span></div></div>

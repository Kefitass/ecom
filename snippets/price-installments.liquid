{%- comment -%}
  Precio con transferencia + pastilla de ahorro + cuotas.
  Uso: {% render 'price-installments', price: product.price, pill: true %}
{%- endcomment -%}
{%- liquid
  assign count = settings.installments_count | plus: 0
  assign min_cents = settings.installments_min | plus: 0 | times: 100
  assign pct = settings.transfer_discount | plus: 0
-%}
{%- if settings.transfer_show and pct > 0 -%}
  {%- liquid
    assign keep = 100 | minus: pct
    assign transfer_price = price | times: keep | divided_by: 100
  -%}
  <p class="transfer-price"><span data-transfer>{{ transfer_price | money }}</span> con TRANSFERENCIA</p>
  {%- if pill -%}
    <p class="save-pill"><span aria-hidden="true">💸</span> Ahorrás un {{ pct }}% · Precio especial de hoy</p>
  {%- endif -%}
{%- endif -%}
{%- if settings.installments_show and count > 1 and price >= min_cents -%}
  {%- assign per_installment = price | divided_by: count -%}
  <p class="installments">
    <strong>{{ count }}</strong> cuotas sin interés
    {%- if settings.installments_show_amount %} de <strong data-installment>{{ per_installment | money }}</strong>{% endif %}
  </p>
{%- elsif settings.installments_show and count > 1 and cart_hint -%}
  {%- assign missing = min_cents | minus: price -%}
  <p class="installments">Sumá <strong>{{ missing | money_without_trailing_zeros }}</strong> más y pagá en <strong>{{ count }} cuotas sin interés</strong></p>
{%- endif -%}

{%- comment -%}
  Logo de marca Casa del Oud.
  Isotipo: el gato blanco sentado dentro del arco árabe (borde dorado, fondo vino),
  con la cola que sostiene una gota de perfume. Imagen: assets/logo-casa-del-oud.webp
  Uso: {% render 'brand-logo', variant: 'light', width: 180 %}
    variant: 'light' (sobre fondo oscuro) | 'dark' (sobre fondo claro) | 'mark' (solo isotipo)
{%- endcomment -%}
{%- liquid
  assign variant = variant | default: 'light'
  assign width = width | default: 180
  if variant == 'dark'
    assign word = 'var(--c-heading)'
    assign sub = 'var(--c-primary)'
  else
    assign word = '#ffffff'
    assign sub = 'var(--c-gold)'
  endif
  assign mark_src = 'logo-casa-del-oud.webp' | asset_url
-%}
{%- if variant == 'mark' -%}
  <img class="brand-logo brand-logo--mark" src="{{ mark_src }}" width="{{ width }}" height="{{ width | times: 4 | divided_by: 3 }}" alt="{{ shop.name }}" style="width: {{ width }}px; height: auto;">
{%- else -%}
  <span class="brand-logo brand-logo--lockup" style="width: {{ width }}px;" role="img" aria-label="{{ shop.name }}">
    <img class="brand-logo__mark" src="{{ mark_src }}" width="60" height="80" alt="">
    <svg class="brand-logo__word" viewBox="0 0 132 62" aria-hidden="true">
      <text x="1" y="24" fill="{{ word }}" font-family="Poppins, 'Helvetica Neue', Arial, sans-serif" font-weight="700" font-size="15" letter-spacing="5">CASA DEL</text>
      <text x="0" y="56" fill="{{ sub }}" font-family="{{ settings.type_accent_font.family }}, Georgia, 'Times New Roman', serif" font-style="italic" font-weight="700" font-size="36">Oud</text>
    </svg>
  </span>
{%- endif -%}

{%- comment -%}
  Tarjeta de producto. Uso: {% render 'product-card', product: product, pill: false %}
{%- endcomment -%}
{%- liquid
  capture badge
    render 'product-tags', product: product, key: 'badge'
  endcapture
  assign badge = badge | strip

  assign discount = 0
  if product.compare_at_price > product.price and settings.card_show_discount
    assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | floor
  endif

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 700
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 550, 700',
          sizes: '(min-width: 990px) 300px, 50vw',
          alt: product.featured_media.alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}

    {%- if settings.card_sticker_top != blank -%}
      <span class="sticker-badge">
        <strong>{{ settings.card_sticker_top }}</strong>
        {%- if settings.card_sticker_bottom != blank -%}<small>{{ settings.card_sticker_bottom }}</small>{%- endif -%}
      </span>
    {%- endif -%}

    {%- if badge != blank -%}<span class="tag tag--violet product-card__badge">🔥 {{ badge }}</span>{%- endif -%}

    <span class="product-card__tags">
      {%- if discount > 0 -%}<span class="tag tag--pink">{{ discount }}% OFF</span>{%- endif -%}
      {%- if settings.card_shipping_label != blank -%}<span class="tag tag--cyan">{{ settings.card_shipping_label }}</span>{%- endif -%}
    </span>

    {%- unless product.available -%}
      <span class="tag tag--dark product-card__soldout">SIN STOCK</span>
    {%- endunless -%}
  </a>

  <div class="product-card__body">
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="price">
      {%- if product.compare_at_price > product.price -%}
        <s class="price__compare">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      <span class="price__current">
        {%- if product.price_varies -%}Desde {% endif -%}
        {{ product.price | money }}
      </span>
    </div>

    {%- if rating != blank -%}
      {% render 'stars', rating: rating.rating, count: rating_count %}
    {%- endif -%}

    {% render 'price-installments', price: product.price, pill: pill %}
  </div>
</article>

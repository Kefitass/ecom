{% comment %}
  MÉTODO 30 · Contacto (sección nativa de Shopify para la página de contacto)
  Instalación: Editar código → Sections → "Agregar una nueva sección" → nombre: metodo30-contacto
  → borrar todo lo que trae → pegar este archivo → Guardar.
  Después: Personalizar → elegir "Páginas" → "contact" arriba al medio → ocultar las secciones
  del tema → Agregar sección (dentro de Plantilla) → "MÉTODO 30 · Contacto".
  El formulario es el de Shopify: los mensajes llegan al mail de la tienda.
{% endcomment %}

{%- liquid
  assign wa = section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = section.settings.whatsapp_mensaje | url_encode
  assign wa_url = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_msg
  assign mail = section.settings.email | default: 'somosmetodo30@gmail.com'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">

<style>
  #m30k-{{ section.id }}{
    --navy:#14213D;--ink:#1C2333;--muted:#5A6478;--line:#E1E5EE;--paper:#F6F7FB;--orange:#E8632E;--gold:#F5D27A;
    --title:'Bricolage Grotesque','Avenir Next','Segoe UI',sans-serif;--body:'Source Sans 3','Segoe UI',system-ui,sans-serif;
    background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16.5px;line-height:1.6;padding-block:56px 80px;overflow:hidden;
  }
  #m30k-{{ section.id }} *{box-sizing:border-box;letter-spacing:normal}
  #m30k-{{ section.id }} h1,#m30k-{{ section.id }} h2,#m30k-{{ section.id }} h3{font-family:var(--title);color:var(--navy);margin:0;line-height:1.15;letter-spacing:-.02em}
  #m30k-{{ section.id }} p{margin:0}
  #m30k-{{ section.id }} a,#m30k-{{ section.id }} a:hover,#m30k-{{ section.id }} a *{text-decoration:none!important}
  #m30k-{{ section.id }} .w{max-width:1060px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
  #m30k-{{ section.id }} .head{text-align:center;max-width:620px;margin:0 auto 36px}
  #m30k-{{ section.id }} .ey{display:block;font-weight:700;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);margin-bottom:12px}
  #m30k-{{ section.id }} .h1{font-size:clamp(30px,4vw,44px);font-weight:800}
  #m30k-{{ section.id }} .sub{color:var(--muted);margin-top:12px;font-size:17px}
  #m30k-{{ section.id }} .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:24px;align-items:start}
  #m30k-{{ section.id }} .box{background:#fff;border:1px solid var(--line);border-radius:22px;padding:28px}
  #m30k-{{ section.id }} .info{display:grid;gap:18px}
  #m30k-{{ section.id }} .row{display:flex;gap:14px;align-items:flex-start}
  #m30k-{{ section.id }} .ico{flex:none;width:42px;height:42px;border-radius:12px;background:var(--navy);color:var(--gold);display:flex;align-items:center;justify-content:center}
  #m30k-{{ section.id }} .ico svg{width:20px;height:20px}
  #m30k-{{ section.id }} .row b{display:block;color:var(--ink)}
  #m30k-{{ section.id }} .row span,#m30k-{{ section.id }} .row a{color:var(--muted);font-size:15.5px;word-break:break-word}
  #m30k-{{ section.id }} .row a:hover{color:var(--orange)}
  #m30k-{{ section.id }} .wa{display:flex;align-items:center;justify-content:center;gap:10px;background:#25D366;color:#fff;font:800 16px/1 var(--title);padding:16px;border-radius:999px;margin-top:6px}
  #m30k-{{ section.id }} .help{margin-top:6px;border-top:1px solid var(--line);padding-top:18px}
  #m30k-{{ section.id }} .help h3{font-size:17px;margin-bottom:10px}
  #m30k-{{ section.id }} .help details{border-bottom:1px solid var(--line)}
  #m30k-{{ section.id }} .help summary{cursor:pointer;list-style:none;padding:11px 24px 11px 0;font-weight:700;font-size:15px;position:relative}
  #m30k-{{ section.id }} .help summary::-webkit-details-marker{display:none}
  #m30k-{{ section.id }} .help summary::after{content:"+";position:absolute;right:0;top:7px;font-size:20px;color:var(--orange)}
  #m30k-{{ section.id }} .help details[open] summary::after{content:"–"}
  #m30k-{{ section.id }} .help p{padding-bottom:12px;font-size:14.5px;color:var(--muted)}
  #m30k-{{ section.id }} .form h2{font-size:22px;margin-bottom:18px}
  #m30k-{{ section.id }} .two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  #m30k-{{ section.id }} .fld{display:grid;gap:6px;margin-bottom:14px}
  #m30k-{{ section.id }} label{font-weight:700;font-size:14.5px}
  #m30k-{{ section.id }} .in{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:13px 14px;font:inherit;color:var(--ink);background:#fff}
  #m30k-{{ section.id }} .in:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(20,33,61,.12)}
  #m30k-{{ section.id }} .send{width:100%;border:0;cursor:pointer;background:var(--orange);color:#fff;font:800 16px/1 var(--title);padding:17px;border-radius:999px;box-shadow:0 10px 24px rgba(232,99,46,.3)}
  #m30k-{{ section.id }} .send:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
  #m30k-{{ section.id }} .ok,#m30k-{{ section.id }} .err{border-radius:12px;padding:12px 14px;margin-bottom:16px;font-weight:600}
  #m30k-{{ section.id }} .ok{background:#E6F6EE;color:#157A4A}
  #m30k-{{ section.id }} .err{background:#FDECEC;color:#B3261E}
  @media (max-width: 820px){#m30k-{{ section.id }} .grid,#m30k-{{ section.id }} .two{grid-template-columns:minmax(0,1fr)}}
</style>

<div id="m30k-{{ section.id }}">
  <div class="w">
    <div class="head">
      <span class="ey">Contacto</span>
      <h1 class="h1">{{ section.settings.titulo }}</h1>
      <p class="sub">{%- if wa == blank -%}{{ section.settings.subtitulo | replace: ', por mail o por WhatsApp', ' o por mail' | replace: ' o por WhatsApp', '' }}{%- else -%}{{ section.settings.subtitulo }}{%- endif -%}</p>
    </div>
    <div class="grid">
      <div class="box info">
        {%- if wa != blank -%}
        <div class="row"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.4A8.5 8.5 0 1 1 21 12z"/></svg></span><div><b>WhatsApp</b><span>{{ section.settings.whatsapp_visible }}</span></div></div>
        {%- endif -%}
        {%- if mail != blank -%}
        <div class="row"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg></span><div><b>Mail</b><a href="mailto:{{ mail }}">{{ mail }}</a></div></div>
        {%- endif -%}
        <div class="row"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><b>Horario</b><span>{{ section.settings.horario }}</span></div></div>
        {%- if wa != blank -%}<a class="wa" href="{{ wa_url }}" target="_blank" rel="noopener">Escribinos por WhatsApp</a>{%- endif -%}
        <div class="help">
          <h3>Antes de escribir, quizás te sirva</h3>
          <details><summary>No me llegó el mail con los ebooks</summary><p>Revisá spam y promociones. Si pasaron más de 15 minutos desde el pago, escribinos con el número de pedido y te los reenviamos.</p></details>
          <details><summary>No puedo entrar a "Mis ebooks"</summary><p>Iniciá sesión con el mismo mail que usaste en la compra. Si compraste con otro mail, cerrá sesión y entrá con ese.</p></details>
          <details><summary>Quiero sumar el ebook 2</summary><p>Escribinos y te ayudamos a sumarlo a tu cuenta.</p></details>
        </div>
      </div>

      <div class="box form">
        <h2>Dejanos tu mensaje</h2>
        {%- form 'contact', id: 'Metodo30Contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="ok" role="status">¡Gracias! Recibimos tu mensaje y te respondemos a la brevedad.</p>
          {%- elsif form.errors -%}
            <p class="err" role="alert">Revisá los datos: {{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="two">
            <div class="fld"><label for="M30Contact-name">Nombre</label>
              <input class="in" type="text" id="M30Contact-name" name="contact[name]" autocomplete="name" placeholder="Tu nombre" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
            <div class="fld"><label for="M30Contact-email">Mail *</label>
              <input class="in" type="email" id="M30Contact-email" name="contact[email]" autocomplete="email" placeholder="tu@email.com" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></div>
          </div>
          <div class="fld"><label for="M30Contact-order">Número de pedido (si ya compraste)</label>
            <input class="in" type="text" id="M30Contact-order" name="contact[pedido]" placeholder="Ej: #1001"></div>
          <div class="fld"><label for="M30Contact-body">Mensaje *</label>
            <textarea class="in" id="M30Contact-body" name="contact[body]" rows="5" required placeholder="Contanos tu consulta: tu pedido, el acceso a tus ebooks, qué opción te conviene...">{{- form.body -}}</textarea></div>
          <button type="submit" class="send">Enviar mensaje</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MÉTODO 30 · Contacto",
  "tag": "div",
  "class": "metodo30-contacto",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿Tenés alguna duda?" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Escribinos por el formulario o por mail y te respondemos lo antes posible." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (solo números, con 549)", "info": "⚠️ Formato Argentina: 549 + código de área sin 0 + número sin 15. Vacío = no se muestra." },
    { "type": "text", "id": "whatsapp_visible", "label": "WhatsApp (como se muestra)" },
    { "type": "text", "id": "whatsapp_mensaje", "label": "Mensaje que se escribe solo", "default": "¡Hola Método 30! Tengo una consulta sobre los ebooks." },
    { "type": "text", "id": "email", "label": "Mail", "default": "somosmetodo30@gmail.com" },
    { "type": "text", "id": "horario", "label": "Horario de atención", "default": "Lunes a domingo de 8 a 22 hs" }
  ],
  "presets": [{ "name": "MÉTODO 30 · Contacto" }]
}
{% endschema %}

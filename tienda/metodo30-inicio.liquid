        { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>Respuesta.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MÉTODO 30 · Inicio",
      "blocks": [
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo recibo los ebooks?", "respuesta": "<p>Apenas se acredita el pago te llega un mail con los <strong>PDF</strong> y el acceso a <strong>\"Mis ebooks\"</strong>, la versión interactiva donde tildás tu avance.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Sirve para mi rubro?", "respuesta": "<p>Sí. El método funciona en cualquier rubro e incluye qué destacar en el CV para <strong>10 rubros distintos</strong>.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Sirve si no tengo experiencia?", "respuesta": "<p>Sí. Hay consejos para el <strong>primer empleo</strong>, y el ebook 2 suma estrategias para compensar la falta de experiencia.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Me garantiza conseguir trabajo?", "respuesta": "<p>Nadie puede garantizarlo: depende de tu dedicación, tu perfil y el mercado de tu rubro. Lo que te da es un <strong>método claro</strong> para hacer una búsqueda muy por encima del promedio.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo puedo pagar?", "respuesta": "<p>Podés pagar con <strong>cualquier tarjeta de crédito en hasta 3 cuotas sin interés</strong>, con débito o con dinero en cuenta de Mercado Pago. El pago se procesa de forma segura a través de Mercado Pago.</p>" } }
      ]
    }
  ]

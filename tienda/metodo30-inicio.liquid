        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Nombre A." },
        { "type": "text", "id": "rubro", "label": "Rubro o puesto", "default": "Administración" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Título de la reseña" },
        { "type": "textarea", "id": "texto", "label": "Reseña", "default": "Lo que contó la persona, con sus palabras." }
      ]
    },
    {
      "type": "pregunta",
      "name": "Pregunta frecuente",
      "limit": 10,
      "settings": [

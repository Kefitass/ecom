    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Quiero el plan" },
    { "type": "header", "content": "Prueba social", "info": "⚠️ Solo datos reales. Si dejás vacío cualquiera de los dos, no se muestra." },
    { "type": "text", "id": "puntuacion", "label": "Puntuación (ej. 4,9)" },
    { "type": "text", "id": "texto_clientes", "label": "Texto junto a las estrellas (ej. 120 opiniones)" },
    { "type": "header", "content": "Confianza" },
    { "type": "text", "id": "texto_pago", "label": "Texto de pago seguro", "default": "Todas las tarjetas, hasta 3 cuotas sin interés" },
    { "type": "header", "content": "Cierre" },
    { "type": "text", "id": "cierre_titulo", "label": "Título", "default": "Tu próximo trabajo empieza hoy" },
    { "type": "textarea", "id": "cierre_texto", "label": "Texto", "default": "En 30 días podés tener un CV que consigue entrevistas y las herramientas para que te elijan." }
  ],
  "blocks": [
    {
      "type": "testimonio",
      "name": "Testimonio (real)",
      "limit": 3,
      "settings": [
